          ],
          "hints": ["The rook on b6 already controls rank 6.", "Ra7+ pushes the king onto rank 8.", "After ...Kh8, Rb8 is mate."],
          "feedback": {
            "b6b7": "Use the a-rook first, keeping the rooks on separate ranks."
          },
          "annotations": {
            "squares": ["a7", "b8"]
          }
        }
      ]
    },
