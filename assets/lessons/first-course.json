    {
      "id": "tactics.hanging",
      "motifs": ["hanging_piece", "exchange"],
      "title": "Count attackers and defenders",
      "requires": ["rules.check"],
      "steps": [
        {
          "kind": "explain",
          "text": "Before moving, look for pieces that can be taken without losing as much in return. A queen is usually worth more than a rook. Count legal recaptures, not just pieces that appear to point at a square.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "Take the undefended queen.",
          "fen": "7k/8/8/3q4/8/8/8/3RK3 w - - 0 1",
          "side": "ivory",
          "goal": "line",
          "solutions": [
            {
              "uci": "d1d5",
              "next": []
            }
          ],
          "hints": ["Follow the d-file.", "The rook can capture on d5."],
          "feedback": {
            "e1f1": "Your king is safe already. Look for the undefended queen."
          },
          "annotations": {
            "squares": []
          }
        },
        {
          "kind": "explain",
          "text": "A defended piece can still be worth taking. Here c4 and g2 both attack d5; the e6 pawn is its only defender. Giving up a pawn to win a rook is a good exchange.",
          "annotations": {
            "squares": ["c4", "g2", "e6", "d5"],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "Capture the rook with the pawn. After the pawn recaptures, take it with the bishop.",
          "fen": "7k/8/4p3/3r4/2P5/8/6B1/6K1 w - - 0 1",
          "side": "ivory",
          "goal": "line",
          "solutions": [
            {
              "uci": "c4d5",
              "next": [
                {
                  "uci": "e6d5",
                  "next": [
                    {
                      "uci": "g2d5",
                      "next": []
                    }
                  ]
                }
              ]
            }
          ],
          "hints": ["Start with the less valuable attacker.", "Play c4xd5; after ...exd5, Bg2xd5."],
          "feedback": {},
          "annotations": {
            "squares": []
          }
        }
      ]
