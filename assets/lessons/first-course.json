    {
      "id": "rules.check",
      "motifs": ["check"],
      "title": "Get out of check",
      "requires": ["rules.sliding"],
      "steps": [
        {
          "kind": "explain",
          "text": "Check means the king is attacked. You must remove that attack now: move the king, take the attacker or block its line. You cannot leave the king in check to attack something else.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "The rook checks along the e-file. Move the king to d1 or f1.",
          "fen": "4r2k/8/8/8/8/8/8/R3K3 w - - 0 1",
          "side": "ivory",
          "goal": "line",
          "solutions": [
            {
              "uci": "e1d1",
              "next": []
            },
            {
              "uci": "e1f1",
              "next": []
            }
          ],
          "hints": ["Leave the e-file.", "Move e1-d1 or e1-f1."],
          "feedback": {
            "a1a8": "Moving your rook there leaves your king in check."
          },
          "annotations": {
            "squares": []
          }
        },
        {
          "kind": "explain",
          "text": "Checkmate means check with no legal escape. Stalemate means no legal move when the king is not in check; it is a draw. A checking move is not always mate. Look for every escape square.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        }
      ]
    },
    {
      "id": "mates.queen",
      "motifs": ["mate"],
      "title": "Support the queen",
      "requires": ["rules.check"],
      "steps": [
        {
          "kind": "explain",
          "text": "A queen can cut off several escape squares. Your king can protect her when she comes close. Keep the kings apart and check that the enemy king cannot capture the queen.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "Deliver any mate in one.",
          "fen": "7k/5K2/8/6Q1/8/8/8/8 w - - 0 1",
          "side": "ivory",
          "goal": "any_mate",
          "solutions": [
            {
              "uci": "g5g7",
              "next": []
            }
          ],
          "hints": ["Which squares does your king already control?", "The king covers g8 and g7. Look for a queen check.", "Qg7 is mate; a check along the h-file can also mate."],
          "feedback": {
            "g5f4": "That move does not check the king. Look for a check that covers the escape squares."
          },
          "annotations": {
            "squares": ["g7", "g8"]
          }
        }
      ]
    },
    {
      "id": "mates.ladder",
      "motifs": [],
      "title": "Walk the rooks up the board",
      "requires": ["mates.queen"],
      "steps": [
        {
          "kind": "explain",
          "text": "Two rooks can take turns cutting off ranks. One blocks the king from coming back; the other gives check on the next rank. Keep the checking rook out of reach.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "Practise this ladder: check on a7, then after ...Kh8 finish on b8.",
          "fen": "8/7k/1R6/R7/8/8/8/4K3 w - - 0 1",
          "side": "ivory",
          "goal": "checkmate",
          "solutions": [
            {
              "uci": "a5a7",
              "next": [
                {
                  "uci": "h7h8",
                  "next": [
