    {
      "id": "rules.first-moves",
      "motifs": ["promotion"],
      "title": "Pawns, knights and kings",
      "requires": [],
      "steps": [
        {
          "kind": "explain",
          "text": "Files run from a to h; ranks run from 1 to 8. White starts on ranks 1 and 2. A pawn moves forward into an empty square and captures one square diagonally. On its first move it may advance two empty squares. On reaching the last rank, a pawn must promote to a queen, rook, bishop or knight.",
          "annotations": {
            "squares": [],
            "arrows": []
          }
        },
        {
          "kind": "task",
          "text": "Move the e-pawn forward one or two squares.",
          "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
          "side": "ivory",
          "goal": "line",
          "solutions": [
            {
              "uci": "e2e3",
              "next": []
            },
            {
              "uci": "e2e4",
              "next": []
            }
          ],
          "hints": ["Find e2, in front of the king.", "Choose e3 or e4."],
          "feedback": {
            "d2d4": "That is the d-pawn. Move the pawn on e2."
          },
          "annotations": {
            "squares": ["e2", "e3", "e4"]
          }
        },
        {
          "kind": "explain",
          "text": "A knight jumps: two squares in one direction, then one across. It may jump over other pieces. From g1 it can reach f3 before any pawn moves.",
          "annotations": {
            "squares": [],
            "arrows": [
              {
                "from": "g1",
                "to": "f3"
              }
            ]
          }
        },
        {
          "kind": "task",
          "text": "Jump the g1 knight to f3.",
          "fen": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
          "side": "ivory",
          "goal": "line",
          "solutions": [
            {
              "uci": "g1f3",
              "next": []
            }
          ],
          "hints": ["A knight can leave the back rank without moving a pawn.", "Move g1-f3."],
          "feedback": {
            "b1c3": "That develops the other knight. This task asks for the g1 knight."
          },
          "annotations": {
            "squares": []
          }
        },
        {
          "kind": "explain",
          "text": "The king moves one square, but never into an attack. Kings may not stand next to each other.",
          "annotations": {
